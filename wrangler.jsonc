{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "qearl-maison",
  "main": "./src/index.js",
  "compatibility_date": "2026-08-18",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "qearl-maison-db",
      "database_id": "b66f4dcb-edc8-4274-a76c-f7273344052c"
    }
  ]
}
