{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "qearl-maison",
  "main": "./src/index.js",
  "compatibility_date": "2026-08-18",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB" }
  ]
}
